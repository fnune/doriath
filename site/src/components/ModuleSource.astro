---
import { Code } from "@astrojs/starlight/components";

interface Props {
  name: string;
}

const sources = import.meta.glob("../../../internal/modules/*.toml", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;

const { name } = Astro.props;
const source = sources[`../../../internal/modules/${name}.toml`];
if (source === undefined) {
  throw new Error(`no built-in module named ${name}`);
}
---

<details>
  <summary><code>{name}.toml</code></summary>
  <Code code={source} lang="toml" />
</details>
